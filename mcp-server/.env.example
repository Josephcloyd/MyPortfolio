# All optional. The server reads the website's ../content.js, so it works with no configuration.

# Public site URL, used to include case-study links in tool results.
PORTFOLIO_SITE_URL=https://your-domain.com

# Supabase project, used only to include certificates managed in admin.html.
PORTFOLIO_SUPABASE_URL=https://your-supabase-project-id.supabase.co
PORTFOLIO_SUPABASE_ANON_KEY=your-supabase-anon-key

# Read a different content file instead of ../content.js.
# PORTFOLIO_CONTENT_FILE=../content.js
